modules = ["nodejs-20", "web", "python-3.12"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Backend"
mode = "sequential"
author = 46438057

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && sleep 5 && uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"

[[workflows.workflow]]
name = "Frontend"
mode = "sequential"
author = 46438057

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm run dev -- --port 5000 --hostname 0.0.0.0"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = 46438057

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Frontend"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5904
externalPort = 3000

[[ports]]
localPort = 8000
externalPort = 8000
